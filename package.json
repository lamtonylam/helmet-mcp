{
  "name": "helmet-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Finnish Helmet-kirjastot public libraries (helmet.finna.fi): search the catalogue and check real-time branch availability.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "helmet-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "helmet",
    "finna",
    "library",
    "kirjasto",
    "helsinki"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "node-html-parser": "^9.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
